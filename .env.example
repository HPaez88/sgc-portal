# Copiar a .env en el VPS (/opt/sgc/.env). NO commitear .env.
DOMAIN=sgc.srv1787150.hstgr.cloud
DB_NAME=sgc_portal
DB_USER=sgc_portal
# Generar: openssl rand -hex 24
DB_PASSWORD=
# Opcional: sin esta clave las funciones de IA responden 503, el resto funciona.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Archivos (evidencias): bucket privado en Backblaze B2 con llave restringida a ese bucket
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=SGC-Portal
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
